# ──────────────────────────────────────────────
# NETRA — Environment Configuration
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=netra
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netra
POSTGRES_USER=netra
POSTGRES_PASSWORD=CHANGE_ME

# ── Neo4j ────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Redpanda (Kafka API) ────────────────────
REDPANDA_BROKERS=redpanda:9092
REDPANDA_SCHEMA_REGISTRY=http://redpanda:8081
EVENT_BUS=redpanda

# ── Redis (Celery broker + cache) ────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO (S3-compatible object store) ───────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=netra
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=netra-snapshots
MINIO_SECURE=false

# ── Tor ──────────────────────────────────────
TOR_SOCKS_PROXY=socks5://tor:9050

# ── JWT Authentication ───────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Security (OWASP) ────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
BCRYPT_ROUNDS=12
MAX_REQUEST_SIZE_MB=10
CSRF_ENABLED=true

# ── Optional external keys (infra correlation) ──
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# ── Live adapter API keys (Phase 1) ─────────
# All free — get keys from:
#   ransomware.live → https://ransomware.live/my (free, 500K calls/month)
#   abuse.ch        → https://auth.abuse.ch/ (free, covers URLhaus + ThreatFox + MalwareBazaar)
#   Etherscan       → https://docs.etherscan.io/ (free, 5 req/sec)
#   TronGrid        → https://www.trongrid.io/ (free)
#   OTX             → https://otx.alienvault.com/ (free)
#   GreyNoise       → https://www.greynoise.io/plans (community tier, free)
#   HIBP            → https://haveibeenpwned.com/API/Key (paid, optional)
#   Blockchair      → https://blockchair.com/api (free tier: 1440 req/day)
RANSOMWARE_LIVE_API_KEY=
ABUSE_CH_AUTH_KEY=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
HIBP_API_KEY=
BLOCKCHAIR_API_KEY=
